{
  "name": "play-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Editor de video de escritorio para Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/misael546/Play-Studio.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run typecheck && npm run build && electron-builder --win nsis --publish never",
    "dist:web": "npm run typecheck && npm run build && electron-builder --win nsis-web --x64 --publish always"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^36.4.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.playstudio.editor",
    "productName": "Play Studio",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Play-Studio-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "out/**",
      "node_modules/**",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "misael546",
        "repo": "Play-Studio",
        "releaseType": "release"
      }
    ],
    "electronLanguages": ["en-US", "es", "es-419"]
  }
}
